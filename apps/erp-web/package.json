    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@lateen-os/eslint-config": "workspace:*",
    "@lateen-os/typescript-config": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
