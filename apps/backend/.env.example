# Lateen OS Platform Backend Host — environment configuration
# Copy to `.env` for local development. Every variable has a safe
# development default (see `src/config/index.ts`), so none of these
# are required to run the backend locally — this file exists to
# document what's configurable and what production requires.

# --- Runtime -----------------------------------------------------
# development | test | production
# Setting this to "production" activates the fail-fast safety checks
# below (see assertProductionSafe in src/config/index.ts) — the process
# refuses to start if JWT secrets are still dev defaults, CORS_ORIGIN is
# "*", or COOKIE_SECURE is not "true".
NODE_ENV=development

PORT=4013
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

PLATFORM_NAME="Lateen OS"

# --- Networking / CORS --------------------------------------------
# Comma-agnostic single origin string (e.g. https://app.lateen-os.example.com).
# Must NOT be "*" in production.
CORS_ORIGIN=*

# --- Database (Prisma) --------------------------------------------
# Read directly by prisma/schema.prisma via env("DATABASE_URL") as well
# as by this app's zod-validated config.
DATABASE_URL=postgresql://lateen:lateen@localhost:5432/lateen_os_backend

# --- Authentication & Authorization ---------------------------------
# MUST be overridden with distinct, high-entropy secrets in production.
# The backend refuses to start in production if either secret is still
# set to its development default, or if both secrets are equal.
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
BCRYPT_SALT_ROUNDS=12

# Set to "true" in production — refresh-token cookies are only sent
# over TLS when this is enabled. The backend refuses to start in
# production if this is not "true".
COOKIE_SECURE=false
