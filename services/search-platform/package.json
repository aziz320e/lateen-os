{
  "name": "@lateen-os/search-platform-service",
  "version": "0.0.0",
  "private": true,
  "description": "Enterprise Search Platform — unified search layer for Lateen OS",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
