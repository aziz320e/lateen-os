# =============================================================================
# Lateen OS — Development Environment (committed defaults, safe for local use)
# =============================================================================

COMPOSE_PROJECT_NAME=lateen-os
LATEEN_ENV=development

LATEEN_NETWORK_NAME=lateen-platform

# PostgreSQL
LATEEN_POSTGRES_HOST=postgres
LATEEN_POSTGRES_PORT=5432
LATEEN_POSTGRES_USER=lateen
LATEEN_POSTGRES_PASSWORD=lateen_dev_postgres
LATEEN_POSTGRES_DB=lateen_os
LATEEN_POSTGRES_HOST_PORT=5432
LATEEN_POSTGRES_MAX_CONNECTIONS=200
LATEEN_POSTGRES_SHARED_BUFFERS=256MB
LATEEN_DATABASE_URL=postgresql://lateen:lateen_dev_postgres@localhost:5432/lateen_os

# Redis
LATEEN_REDIS_HOST=redis
LATEEN_REDIS_PORT=6379
LATEEN_REDIS_PASSWORD=lateen_dev_redis
LATEEN_REDIS_HOST_PORT=6379
LATEEN_REDIS_URL=redis://:lateen_dev_redis@localhost:6379/0

# NATS
LATEEN_NATS_HOST=nats
LATEEN_NATS_CLIENT_PORT=4222
LATEEN_NATS_MONITORING_PORT=8222
LATEEN_NATS_HOST_CLIENT_PORT=4222
LATEEN_NATS_HOST_MONITORING_PORT=8222
LATEEN_NATS_URL=nats://localhost:4222

# MinIO
LATEEN_MINIO_HOST=minio
LATEEN_MINIO_API_PORT=9000
LATEEN_MINIO_CONSOLE_PORT=9001
LATEEN_MINIO_HOST_API_PORT=9000
LATEEN_MINIO_HOST_CONSOLE_PORT=9001
LATEEN_MINIO_ROOT_USER=lateen-minio
LATEEN_MINIO_ROOT_PASSWORD=lateen_dev_minio
LATEEN_MINIO_BUCKET=lateen-assets
LATEEN_MINIO_ENDPOINT=http://localhost:9000
LATEEN_MINIO_REGION=us-east-1

# Qdrant
LATEEN_QDRANT_HOST=qdrant
LATEEN_QDRANT_HTTP_PORT=6333
LATEEN_QDRANT_GRPC_PORT=6334
LATEEN_QDRANT_HOST_HTTP_PORT=6333
LATEEN_QDRANT_HOST_GRPC_PORT=6334
LATEEN_QDRANT_URL=http://localhost:6333
LATEEN_QDRANT_COLLECTION=lateen-embeddings

# Grafana
LATEEN_GRAFANA_HOST=grafana
LATEEN_GRAFANA_PORT=3000
LATEEN_GRAFANA_HOST_PORT=3000
LATEEN_GRAFANA_ADMIN_USER=admin
LATEEN_GRAFANA_ADMIN_PASSWORD=lateen_dev_grafana
LATEEN_GRAFANA_URL=http://localhost:3000

# Prometheus
LATEEN_PROMETHEUS_HOST=prometheus
LATEEN_PROMETHEUS_PORT=9090
LATEEN_PROMETHEUS_HOST_PORT=9090
LATEEN_PROMETHEUS_URL=http://localhost:9090
LATEEN_PROMETHEUS_RETENTION=15d

# OpenTelemetry Collector
LATEEN_OTEL_HOST=otel-collector
LATEEN_OTEL_GRPC_PORT=4317
LATEEN_OTEL_HTTP_PORT=4318
LATEEN_OTEL_HEALTH_PORT=13133
LATEEN_OTEL_METRICS_PORT=8888
LATEEN_OTEL_HOST_GRPC_PORT=4317
LATEEN_OTEL_HOST_HTTP_PORT=4318
LATEEN_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# PgAdmin
LATEEN_PGADMIN_HOST=pgadmin
LATEEN_PGADMIN_PORT=5050
LATEEN_PGADMIN_HOST_PORT=5050
LATEEN_PGADMIN_EMAIL=admin@lateen.local
LATEEN_PGADMIN_PASSWORD=lateen_dev_pgadmin
LATEEN_PGADMIN_URL=http://localhost:5050

# Resource limits
LATEEN_POSTGRES_CPU=1.0
LATEEN_POSTGRES_MEM=1g
LATEEN_REDIS_CPU=0.5
LATEEN_REDIS_MEM=512m
LATEEN_NATS_CPU=0.5
LATEEN_NATS_MEM=256m
LATEEN_MINIO_CPU=0.5
LATEEN_MINIO_MEM=512m
LATEEN_QDRANT_CPU=1.0
LATEEN_QDRANT_MEM=1g
LATEEN_GRAFANA_CPU=0.5
LATEEN_GRAFANA_MEM=512m
LATEEN_PROMETHEUS_CPU=0.5
LATEEN_PROMETHEUS_MEM=512m
LATEEN_OTEL_CPU=0.5
LATEEN_OTEL_MEM=256m
LATEEN_PGADMIN_CPU=0.25
LATEEN_PGADMIN_MEM=256m

LATEEN_BACKUP_DIR=./backups
