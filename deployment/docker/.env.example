# Environment file for `docker compose -f deployment/docker/docker-compose.apps.yml up`.
#
# Copy this to `deployment/docker/.env` (Compose auto-loads a `.env` file
# from the same directory as the compose file) and fill in real values
# before deploying anywhere other than a throwaway local test — the
# backend refuses to start in production with insecure/default values
# (see apps/backend/src/config/index.ts's assertProductionSafe).

# Required — the backend fails fast if either is missing. Generate with,
# e.g., `openssl rand -hex 32`. Must be distinct from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional — defaults shown below match a local single-machine deployment.
# Must be an explicit origin (not "*") and COOKIE_SECURE must be "true" in
# any real (TLS-terminated) deployment.
CORS_ORIGIN=http://localhost:3013
COOKIE_SECURE=true
