# syntax=docker/dockerfile:1.7
# Multi-stage backend image for Lateen OS services (Fastify/NestJS + Prisma)
#
# Build example:
#   docker build -f deployment/docker/Dockerfile.backend \
#     --build-arg SERVICE_PACKAGE=@lateen-os/identity-service \
#     --build-arg SERVICE_PATH=services/identity-service \
#     --build-arg SERVICE_PORT=4003 \
#     -t lateen-os/identity-service:latest .

ARG NODE_VERSION=20-alpine

FROM node:${NODE_VERSION} AS base
RUN apk add --no-cache libc6-compat openssl \
  && corepack enable \
  && corepack prepare pnpm@9.15.9 --activate
WORKDIR /repo

FROM base AS pruner
ARG SERVICE_PATH
COPY . .
RUN pnpm dlx turbo prune --docker --filter=./${SERVICE_PATH}

FROM base AS deps
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

FROM base AS builder
ARG SERVICE_PACKAGE
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=pruner /repo/out/full/ .
RUN pnpm --filter ${SERVICE_PACKAGE} build

FROM node:${NODE_VERSION} AS runner
RUN apk add --no-cache libc6-compat openssl wget \
  && addgroup -g 10001 -S lateen \
  && adduser -u 10001 -S lateen -G lateen
WORKDIR /repo
ENV NODE_ENV=production

ARG SERVICE_PATH
ARG SERVICE_PORT=4000
ENV SERVICE_PATH=${SERVICE_PATH}
ENV PORT=${SERVICE_PORT}
ENV HOST=0.0.0.0

COPY --from=builder --chown=lateen:lateen /repo/ ./

USER lateen
WORKDIR /repo/${SERVICE_PATH}
EXPOSE ${SERVICE_PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT}/health || exit 1

CMD ["node", "dist/main.js"]
