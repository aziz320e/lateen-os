{
  "name": "@lateen-os/extension-system",
  "version": "0.0.0",
  "private": true,
  "description": "Lateen OS Extension System — discover, validate, load, and manage platform extensions",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@lateen-os/typescript-config": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.5.8",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@lateen-os/sdk": "workspace:*",
    "@lateen-os/shared-kernel": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "pino": "^9.6.0",
    "semver": "^7.7.1",
    "zod": "^3.24.2"
  }
}
