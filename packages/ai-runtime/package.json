{
  "name": "@lateen-os/ai-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "AI Runtime — operating system for AI agents in Lateen OS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@lateen-os/typescript-config": "workspace:*",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@lateen-os/ai-provider-hub": "workspace:*",
    "@lateen-os/business-dna": "workspace:*",
    "@lateen-os/capability-engine": "workspace:*",
    "@lateen-os/decision-engine": "workspace:*",
    "@lateen-os/domain-graph": "workspace:*",
    "@lateen-os/institutional-memory": "workspace:*",
    "@lateen-os/intelligence-engine": "workspace:*",
    "@lateen-os/shared-kernel": "workspace:*",
    "zod": "^3.24.1"
  }
}
