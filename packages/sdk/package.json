{
  "name": "@lateen-os/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Lateen SDK — official developer interface for extending Lateen OS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lateen-sdk": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@lateen-os/typescript-config": "workspace:*",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@lateen-os/ai-brain": "workspace:*",
    "@lateen-os/ai-runtime": "workspace:*",
    "@lateen-os/ai-workforce": "workspace:*",
    "@lateen-os/business-dna": "workspace:*",
    "@lateen-os/kernel": "workspace:*",
    "@lateen-os/multi-agent": "workspace:*",
    "@lateen-os/shared-kernel": "workspace:*",
    "@lateen-os/workflow-engine": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  }
}
