{
  "name": "@lateen-os/admin-console",
  "version": "0.0.0",
  "private": true,
  "description": "Admin Console — administration, identity administration, system settings, configuration management, audit center, system monitoring, and the administration dashboard for Lateen OS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@lateen-os/typescript-config": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@lateen-os/ai-compliance-engine": "workspace:*",
    "@lateen-os/ai-governance-engine": "workspace:*",
    "@lateen-os/ai-security-engine": "workspace:*",
    "@lateen-os/analytics-engine": "workspace:*",
    "@lateen-os/api-gateway": "workspace:*",
    "@lateen-os/business-dna": "workspace:*",
    "@lateen-os/communication-hub": "workspace:*",
    "@lateen-os/institutional-memory": "workspace:*",
    "@lateen-os/observability-engine": "workspace:*",
    "@lateen-os/shared-kernel": "workspace:*"
  }
}
