{
  "name": "@lateen-os/integration-tests",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end integration test suite verifying Lateen OS engines work together through createLateen()",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
