    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@lateen-os/shared-kernel": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lateen-os/typescript-config": "workspace:*",
    "@types/node": "^22.10.7",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
