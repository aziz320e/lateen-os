{
  "name": "@lateen-os/ai-provider-hub",
  "version": "0.0.0",
  "private": true,
  "description": "AI Provider Hub — canonical LLM provider abstraction for Lateen OS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
