{
  "name": "@lateen-os/document-management-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Document Management Engine — document lifecycle, folders, document types, version control, metadata, relationships, and search for Lateen OS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@lateen-os/typescript-config": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@lateen-os/analytics-engine": "workspace:*",
    "@lateen-os/business-dna": "workspace:*",
    "@lateen-os/communication-hub": "workspace:*",
    "@lateen-os/crm-engine": "workspace:*",
    "@lateen-os/customer-success-engine": "workspace:*",
    "@lateen-os/institutional-memory": "workspace:*",
    "@lateen-os/project-management-engine": "workspace:*",
    "@lateen-os/shared-kernel": "workspace:*",
    "@lateen-os/workflow-engine": "workspace:*"
  }
}
